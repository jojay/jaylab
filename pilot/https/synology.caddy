https://synstation.jaylab.org {
	bind {$PILOT_IPV4}
	tls {
		issuer acme {
			dir {$ACME_DIRECTORY}
			dns cloudflare {env.CF_API_TOKEN}
			resolvers 1.1.1.1 1.0.0.1
		}
	}
	reverse_proxy https://192.168.50.1:5001 {
		header_up Host {host}
		transport http {
			tls_server_name synstation.jaylab.local
			tls_trust_pool file /etc/caddy/synology-backend-ca.pem
		}
	}
}
