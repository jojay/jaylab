https://login.jaylab.org {
	bind {$PILOT_IPV4}
	tls {
		issuer acme {
			dir {$ACME_DIRECTORY}
			dns cloudflare {env.CF_API_TOKEN}
			resolvers 1.1.1.1 1.0.0.1
		}
	}
	reverse_proxy https://192.168.10.19:9443 {
		header_up Host {host}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {remote_host}
		transport http {
			tls_server_name login.jaylab.org
			tls_trust_pool file /etc/caddy/authentik-backend-ca.pem
		}
	}
}
